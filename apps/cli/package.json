{
  "name": "submarine-cli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "bin": {
    "submarine": "src/index.tsx"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "demo": "bun run test/demo.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --minify src/index.tsx --outfile dist/submarine",
    "build:windows": "bun build --compile --minify --target=bun-windows-x64 src/index.tsx --outfile dist/submarine.exe",
    "build:macos": "bun build --compile --minify --target=bun-darwin-arm64 src/index.tsx --outfile dist/submarine-macos"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "bun": "^1.4.2",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "^6.1.5",
    "typescript": "^7.0.2"
  }
}
