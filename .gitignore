# Rust
# build output of the whole cargo workspace, Windows and macOS cross builds included
# (scripts/ point CARGO_TARGET_DIR to target/windows-build and target/macos-check)
/target/
**/*.rs.bk

# Node.js
node_modules/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
# release artifacts of scripts/build-windows.sh (installer, service, CLI) and the
# test-signed driver downloaded from the "windows-driver" workflow
/dist/
# single-file executables of the CLI built with `bun run build`
apps/cli/dist/
# frontend bundle of the desktop app, rebuilt by Vite on every `tauri build`
apps/desktop/dist/
# schemas and platform projects generated by the Tauri CLI
apps/desktop/src-tauri/gen/
# sidecars (service and CLI) copied in by the build scripts before bundling
apps/desktop/src-tauri/binaries/

# Design and internal docs
# UI mockups and screenshots used during development, and internal notes:
# NOT needed to build, run or contribute to the project
/design/
/docs/

# Windows driver (Visual Studio)
# per-user settings, IntelliSense cache and build output of the split tunnel driver
third_party/win-split-tunnel/**/.vs/
third_party/win-split-tunnel/**/*.vcxproj.user
third_party/win-split-tunnel/**/x64/
third_party/win-split-tunnel/**/ARM64/
third_party/win-split-tunnel/**/Debug/
third_party/win-split-tunnel/**/Release/

# Signing material
# certificates and keys for driver and installer signing must NEVER end up in the
# repository: in CI they come from the SUBMARINE_DRIVER_PFX* secrets
*.pfx
*.p12
*.pem
*.key
*.cer

# WireGuard configurations
# real tunnel configurations contain the private key of the peer.
# NB: test fixtures must not use the .conf extension, or they have to be re-included
# here explicitly with a `!` pattern
*.conf

# Environment variables
.env
.env.*

# Logs and crash dumps
*.log
# core dumps from crashed tools (Linux) and minidumps (Windows)
core.[0-9]*
*.dmp

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Claude Code
.claude/
