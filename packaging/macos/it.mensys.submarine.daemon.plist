<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job of the Submarine service: runs submarine-daemon as root at boot and
  restarts it whenever it exits. Installed in /Library/LaunchDaemons by install.sh.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>it.mensys.submarine.daemon</string>
    <!-- the daemon writes and rotates its own log: launchd would keep the file open
         and defeat the rotation -->
    <key>ProgramArguments</key>
    <array>
        <string>/Library/PrivilegedHelperTools/submarine-daemon</string>
        <string>--log-file</string>
        <string>/var/log/submarine-daemon.log</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- restarted after a crash, so the kill switch is re-evaluated quickly -->
    <key>KeepAlive</key>
    <true/>
    <!-- only what is printed before the log is opened, e.g. a bad option -->
    <key>StandardErrorPath</key>
    <string>/var/log/submarine-daemon.stderr.log</string>
</dict>
</plist>
